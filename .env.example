PUBLIC_ORIGIN=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8080
# Set these to paths created by bun run ops init.
DATA_DIR=/path/to/private/state/data
CONFIG_FILE=/path/to/private/state/config/mounts.json
SESSION_SECRET_FILE=/path/to/private/state/config/session.key
BOOTSTRAP_FILE=/path/to/private/state/config/bootstrap.json
# Optional workspace logo and favicon (absolute PNG path, up to 512 × 512).
# BRAND_ICON_FILE=/path/to/private/state/config/workspace.png
MAX_CHUNK_BYTES=16777216
MAX_TRANSFERS=32
MAX_TRANSFERS_PER_USER=8
TRANSFER_BYTES_PER_SECOND=0
UPLOAD_TTL_SECONDS=86400
