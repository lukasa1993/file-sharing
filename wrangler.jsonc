{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lshare",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dl.ldev.cloud",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".cloudflare/assets",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE",
        "class_name": "CloudWorkspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CloudWorkspace"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lshare-objects"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://dl.ldev.cloud",
    "R2_BUCKET_NAME": "lshare-objects",
    "LSHARE_SCHEMA": "sqlite-catalog-v1"
  },
  "secrets": {
    "required": [
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "MAIL_FROM",
      "ALERT_EMAIL"
    ]
  }
}
