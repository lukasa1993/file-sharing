{
  "private": true,
  "type": "module",
  "devDependencies": {
    "@ai-sdk/openai": "4.0.125",
    "@cloudflare/workers-types": "5.20261127.1",
    "@e2e-dev/core": "0.25.0",
    "@e2e-dev/web": "0.17.0",
    "@effect/language-service": "0.87.5",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "1.4.5",
    "ai": "7.0.183",
    "aws4fetch": "1.0.20",
    "e2e": "0.25.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "typescript": "6.0.3",
    "wrangler": "4.169.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "test:e2e": "e2e run",
    "dev": "bun run --watch server.ts",
    "start": "bun run server.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cloudflare.json && tsc -p tests/cloudflare/tsconfig.json",
    "effect:check": "effect-language-service diagnostics --project tsconfig.json --severity error",
    "lint": "bun scripts/quality.ts lint",
    "format": "bun fmt --no-semi --single-quote app shared cloudflare server.ts public scripts tests e2e.config.ts",
    "format:check": "bun fmt --check --no-semi --single-quote app shared cloudflare server.ts public scripts tests e2e.config.ts",
    "test": "bun test tests",
    "test:unit": "bun test tests/*.test.ts",
    "test:integration": "bun test tests/integration",
    "test:security": "bun test tests/security",
    "test:performance": "bun test tests/performance",
    "coverage": "bun scripts/quality.ts coverage",
    "mutation": "bun scripts/quality.ts mutation",
    "mutation:all": "bun scripts/quality.ts mutation-all",
    "audit": "bun audit --audit-level=high",
    "quality": "bun scripts/quality.ts quality",
    "release:check": "bun scripts/quality.ts release",
    "ops": "bun scripts/ops.ts",
    "test:e2e:fixture": "bun scripts/e2e.ts",
    "test:e2e:packaged": "bun scripts/e2e.ts --packaged",
    "test:container:tls": "bun scripts/container-https.ts",
    "effect:editor": "bun scripts/effect-editor-check.ts",
    "build:selfhost": "bun scripts/build.ts selfhost",
    "cloud:assets": "bun scripts/cloud-assets.ts",
    "cloud:check": "bun scripts/cloud-preflight.ts",
    "cloud:e2e": "bun scripts/cloud-fixture.ts",
    "cloud:deploy": "bun scripts/cloud-deploy.ts",
    "build:cloudflare": "bun run cloud:assets && wrangler deploy --dry-run --outdir .cloudflare/bundle"
  },
  "dependencies": {
    "effect": "4.1.7",
    "remix": "3.3.0"
  },
  "name": "lshare",
  "version": "0.1.0",
  "packageManager": "bun@1.4.5"
}
